--===========================================================================
-- SCALE REGISTRY
--===========================================================================
local ScaleReg = {frames = {}, texts = {}, corners = {}, strokes = {}}
local function regFrame(o, s) table.insert(ScaleReg.frames, {obj=o, base=s}) end
local function regText(o, s)  table.insert(ScaleReg.texts,  {obj=o, base=s}) end
local function regCorner(o, r)table.insert(ScaleReg.corners,{obj=o, base=r}) end
local function regStroke(o, t)table.insert(ScaleReg.strokes,{obj=o, base=t}) end

local function applyScale(scale)
    for _, e in ipairs(ScaleReg.frames) do
        local b = e.base
        e.obj.Size = UDim2.new(b.X.Scale, math.floor(b.X.Offset * scale),
                               b.Y.Scale, math.floor(b.Y.Offset * scale))
    end
    for _, e in ipairs(ScaleReg.texts) do
        e.obj.TextSize = math.max(6, math.floor(e.base * scale))
    end
    for _, e in ipairs(ScaleReg.corners) do
        local r = e.base
        e.obj.CornerRadius = UDim.new(r.Scale, math.floor(r.Offset * scale))
    end
    for _, e in ipairs(ScaleReg.strokes) do
        e.obj.Thickness = math.max(1, e.base * scale)
    end
end

--===========================================================================
-- UTIL
--===========================================================================
local function disconnectAll(tbl)
    for _, c in ipairs(tbl) do pcall(function() c:Disconnect() end) end
    table.clear(tbl)
end

local function phaseColor(offset)
    local t = (State.AccentPhase + offset) % 1
    local v = math.abs(((t * 2) % 2) - 1)
    local c = math.floor(v * 255)
    return Color3.fromRGB(c, c, c)
end

RunService.RenderStepped:Connect(function(dt)
    State.AccentPhase = (State.AccentPhase + dt * 0.25) % 1
end)

local function keyName(keyCode)
    if not keyCode then return "NONE" end
    return keyCode.Name:upper()
end

--===========================================================================
-- GIF ENGINE
--===========================================================================
local GIF_Image = nil
local GIF_Index = 1
local GIF_Accum = 0
local GIF_FrameTime = 1 / math.max(1, GIF_FPS)

local function gifStep(dt)
    if not State.GIFTheme then return end
    if not GIF_Image or not GIF_Image.Parent then return end
    if #GIF_FRAMES == 0 then return end

    GIF_Accum = GIF_Accum + dt
    while GIF_Accum >= GIF_FrameTime do
        GIF_Accum = GIF_Accum - GIF_FrameTime
        GIF_Index = GIF_Index + 1
        if GIF_Index > #GIF_FRAMES then GIF_Index = 1 end
        GIF_Image.Image = GIF_FRAMES[GIF_Index]
    end
end

